{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nbadle",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // Static site (HTML/CSS/JS + players.json). Only /api/* reaches the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // One Durable Object per Versus room, keyed by PIN.
  "durable_objects": {
    "bindings": [{ "name": "VS_ROOM", "class_name": "VsRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VsRoom"] }],

  "observability": { "enabled": true }
}
